# Copy to web/.env.local and fill in. web/.env.local is git-ignored: never commit a token.
# Cesium ion access token (free Community account): terrain and satellite imagery. Without it the app runs on a flat globe.
VITE_CESIUM_ION_TOKEN=
# Optional Mapillary client token (never the client secret): 360 street views. Without it 360 uses Panoramax and KartaView only.
VITE_MAPILLARY_TOKEN=
